# Docent environment variables.
# Copy to .env for local development. Defaults below match compose.yaml, so a
# local setup works without a .env file at all. Never commit a real .env.

# local | test | staging | production
DOCENT_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# Postgres. The app and worker use roles that cannot bypass row-level security.
# Migrations run as the owner role. On Neon, use the pooled host for the app and
# worker, and the direct (unpooled) host for migrations and pg_dump.
DATABASE_URL=postgresql://docent_app:docent_app@127.0.0.1:5432/docent
WORKER_DATABASE_URL=postgresql://docent_worker:docent_worker@127.0.0.1:5432/docent
MIGRATION_DATABASE_URL=postgresql://docent_owner:docent_owner@127.0.0.1:5432/docent
DB_POOL_MIN=1
DB_POOL_MAX=10

# Redis is optional. Leave empty for local-only mode (rate limits per process).
# Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=redis://127.0.0.1:6379/0

# Secrets. Required outside local and test. Generate with: openssl rand -hex 32
SECRET_KEY=local-dev-secret-change-me
INTERNAL_TOKEN=local-internal-token-change-me

# Admin web app origin. Used for email links and the CSRF origin check.
WEB_ORIGIN=http://localhost:3000
# JSON list of extra allowed origins, for example ["https://app.example.com"]
EXTRA_ALLOWED_ORIGINS=[]
SESSION_TTL_DAYS=14
# Defaults to true in staging and production.
# COOKIE_SECURE=true
# IPs allowed to set X-Forwarded-For (the web app or load balancer).
FORWARDED_ALLOW_IPS=127.0.0.1

# Email. Mailpit locally (UI at http://localhost:8025). Resend SMTP in production:
# SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USE_TLS=true SMTP_USERNAME=resend
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
EMAIL_FROM=Docent <hello@docent.local>

# Job worker. The API wakes the worker at WORKER_URL after enqueueing.
# On Neon Free keep the idle poll long (900) so the database can scale to zero.
WORKER_URL=http://127.0.0.1:8001
JOB_IDLE_POLL_SECONDS=60
JOB_LEASE_SECONDS=300

# Ollama runs natively on the host. Embeddings always run here.
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma

# Language model: any OpenAI-compatible endpoint. The default, gemma4:cloud,
# runs through the local Ollama after `ollama signin` (synthetic or demo data
# only on free tiers). Offline: `ollama pull qwen3:1.7b` and set it here; it is
# slow on a CPU. Paid providers: set LLM_BASE_URL, LLM_API_KEY and LLM_MODEL.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma4:cloud
LLM_API_KEY=
# auto picks json_schema, or tool for Ollama Cloud models
LLM_STRUCTURED_OUTPUT=auto
LLM_MAX_CONCURRENCY=2

# Payments (Stripe). Leave empty to run on trials and manual plans only.
# Test keys: https://dashboard.stripe.com/test/apikeys. Then `pnpm stripe:sync`
# creates the products and prices. The webhook secret comes from
# `docker compose --profile stripe up` (logs) locally, or the dashboard endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Tax on checkout. Turn on after setting up tax registrations in Stripe.
STRIPE_AUTOMATIC_TAX=false
# Only for tests against stripe-mock: http://localhost:12111
STRIPE_API_BASE=

# Social profiles in the site footer. A platform shows only once its URL is set.
# GitHub defaults to this repository; set it to an empty value to hide it.
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/talibabbas77/agentic-workflow-fastapi
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# "See it live" on the landing page: the two demo sites with the widget installed
# (apps/demo-host, `pnpm demo-host`). Empty means these local defaults.
NEXT_PUBLIC_SHOWCASE_PUBLIC_URL=http://localhost:5173/lumen-notes
NEXT_PUBLIC_SHOWCASE_APP_URL=http://localhost:5173/parcelwise

# Web app (apps/web) reads this to reach the API from the server side.
API_INTERNAL_URL=http://127.0.0.1:8000

# Backups (infra/backup). S3-compatible storage such as Cloudflare R2.
# The backup role must bypass RLS: the Neon project owner, or the local superuser.
BACKUP_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/docent
# Public key from `pnpm backup:keygen`. The private key stays offline.
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=
BACKUP_LOCAL_KEEP_DAYS=14
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_LOCAL_DIR=./backups
